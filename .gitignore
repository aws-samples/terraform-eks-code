# Local .terraform directories
**/.terraform/*
**/bin/*
idp/private/*
# .tfstate files
*.tfstate
*.tfstate.*
*.DS_Store

# Crash log files
crash.log

# Ignore any .tfvars files that are generated automatically for each Terraform run. Most
# .tfvars files are managed as part of configuration and so should be included in
# version control.
#
# example.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
#
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*
*tfplan*
terraform*
kubectl*
**/old/*
**/aws/*
**/sw/*
jq
**/*.old
**/net-v2/*
**/notused/*
**/.vscode/*

# .terraform.lock.hcl files are committed (provider version + hash pinning)
extra/.observability/priv-vars.tf
.DS_Store
docker-extract.sh
.DS_Store
Private.md
.DS_Store
.aws-staff/NOTES.md
.notused/idp/private/github-token
.notused/idp/private/github-integration.yaml
.aws-staff/saml.sh
.vscode/notes.md
.DS_Store
.vscode/vscode-isengard.yaml
.DS_Store
# Terraform working dirs and lock info (any depth)
**/.terraform/
.terraform.tfstate.lock.info
crash.*.log
# Written by tf-setup/gen-backend.sh
**/tmp-buck.txt
# Local agent/workflow artefacts
.agents/
.worktrees/
# Generated by tf-setup/gen-backend.sh (contain the account-specific state bucket)
tf-setup/generated/backend-*.tf
# Logs written by .aws-staff/build-all.sh and destroy-everything.sh
.aws-staff/build.log
.aws-staff/destroy.log
